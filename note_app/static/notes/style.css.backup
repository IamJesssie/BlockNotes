/* CSS Variables from Figma Design */
:root {
    --bg-1: #1A092D;
    --bg-2: #02042C;
    --bg-3: #101211;
    --accent-blue: #384BFF;
    --accent-purple: #A020F0;
    --accent-cyan: #00D9FF;
    --header-bg: rgba(50, 37, 90, 0.4);
    --header-border: rgba(227, 226, 229, 0.1);
    --text-primary: rgba(255, 255, 255, 0.9);
    --text-secondary: rgba(255, 255, 255, 0.6);
    --text-muted: rgba(255, 255, 255, 0.4);
    --surface-primary: rgba(255, 255, 255, 0.05);
    --surface-secondary: rgba(255, 255, 255, 0.1);
}

/* Global Styles */
body {
    background: linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 50%, var(--bg-3) 100%);
    color: #E3E2E5;
    font-family: 'Arimo', sans-serif;
    height: 100vh;
    margin: 0;
    overflow: hidden;
    position: relative;
}

/* Background Gradient Blobs */
.app-bg-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(240px);
    pointer-events: none;
    z-index: -1;
}

.app-bg-blob.one {
    width: 384px;
    height: 384px;
    left: 50%;
    top: 20%;
    transform: translateX(-50%);
    background: var(--accent-blue);
    opacity: 0.58;
}

.app-bg-blob.two {
    width: 384px;
    height: 384px;
    right: 10%;
    top: 35%;
    background: var(--accent-purple);
    opacity: 0.65;
}

/* New Header */
.new-header {
    background: var(--header-bg);
    border: 1px solid var(--header-border);
    border-radius: 16px;
    margin: 32px 16px 12px;
    /* lowered from the top and added breathing space below */
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    position: relative;
    z-index: 10;
}

.logo-block {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
}

.logo-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 12px;
    background: linear-gradient(to bottom, var(--accent-blue), var(--accent-purple));
    box-shadow: 0px 0px 22px 0px rgba(56, 75, 255, 0.35), 0px 0px 44px 0px rgba(160, 32, 240, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
}

.logo-icon-wrapper img {
    width: 20px;
    height: 20px;
}

.logo-text {
    font-size: 16px;
    font-weight: 400;
    color: var(--text-primary);
    background: linear-gradient(172deg, var(--accent-purple), var(--accent-blue));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.user-controls {
    display: flex;
    align-items: center;
    gap: 12px;
}

.user-info-pill {
    background: var(--surface-primary);
    border: 1px solid var(--surface-secondary);
    border-radius: 12px;
    padding: 0 12px;
    height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-primary);
}

.user-info-pill img {
    width: 16px;
    height: 16px;
}

.logout-button {
    background: var(--header-bg);
    border: 1px solid #32255A;
    border-radius: 10px;
    padding: 8px 12px;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s ease;
}

.logout-button:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
}

.logout-button img {
    width: 16px;
    height: 16px;
}

/* Notes App Layout */
.notes-app-container {
    display: flex;
    height: calc(100vh - 200px);
    /* increased top spacing so header + container feel balanced on fullscreen */
    gap: 20px;
    padding: 32px 16px 24px 16px;
    /* more breathing room around content */
    position: relative;
    z-index: 1;
    align-items: stretch;
}

.notes-sidebar {
    width: 320px;
    height: 830px;
    flex-shrink: 0;
    background: var(--header-bg);
    border: 1px solid var(--header-border);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
}

.note-editor-pane {
    flex-grow: 1;
    height: 830px;
    background: var(--header-bg);
    border: 1px solid var(--header-border);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.9);
    padding: 24px;
    overflow: hidden;
}

.sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 16px 16px 0 16px;
}

.sidebar-title {
    font-size: 16px;
    color: var(--text-primary);
    margin: 0;
    font-weight: 400;
}

.sidebar-status {
    padding: 0 16px;
}

.sidebar-search {
    padding: 6px 16px 10px;
    /* small top/bottom padding for breathing room */
    position: relative;
    margin-bottom: 8px;
    overflow: visible;
    /* allow input & icon to render freely */
    z-index: 6;
    /* keep search above nearby controls */
}

.sidebar-sort {
    padding: 0 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    z-index: 1;
    /* ensure sort control sits below the search input */
}

/* Glassmorphic sort control to match Figma */
.sort-select {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--header-border);
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: 12px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 8px 30px rgba(22, 12, 47, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.02);
    appearance: none;
    -moz-appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    font-size: 13px;
    padding-right: 36px;
    /* room for custom arrow */
}

/* Custom arrow using background */
.sort-select {
    background-image:
        linear-gradient(180deg, transparent, transparent),
        radial-gradient(circle at calc(100% - 14px) center, rgba(255, 255, 255, 0.14) 30%, transparent 31%);
    background-repeat: no-repeat;
    background-position: calc(100% - 14px) center;
    background-size: 8px 8px, 8px 8px;
}

.sort-select:focus {
    outline: none;
    border-color: rgba(56, 75, 255, 0.7);
    box-shadow: 0 8px 40px rgba(56, 75, 255, 0.12);
}

/* Custom dropdown (glassmorphic) menu for sort control */
.sort-dropdown {
    position: relative;
    display: inline-block;
}

.sort-dropdown-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--header-border);
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: 12px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 8px 30px rgba(22, 12, 47, 0.5);
    cursor: pointer;
    font-size: 13px;
}

.sort-dropdown.open .sort-dropdown-toggle {
    box-shadow: 0 12px 48px rgba(56, 75, 255, 0.18);
    border-color: rgba(56, 75, 255, 0.5);
}

.sort-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 180px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--header-border);
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 12px 40px rgba(22, 12, 47, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    display: none;
    z-index: 40;
}

.sort-dropdown.open .sort-dropdown-menu {
    display: block;
}

.sort-option {
    padding: 8px 12px;
    color: var(--text-primary);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.12s ease, transform 0.06s ease;
    margin: 4px 2px;
    font-size: 14px;
}

.sort-option:hover,
.sort-option:focus {
    background: rgba(56, 75, 255, 0.12);
    transform: translateY(-2px);
}

.sort-option.selected,
.sort-option[aria-selected="true"] {
    background: linear-gradient(90deg, rgba(56, 75, 255, 0.18), rgba(160, 32, 240, 0.18));
    font-weight: 600;
}

.sort-dropdown-toggle:focus {
    outline: none;
    box-shadow: 0 10px 30px rgba(56, 75, 255, 0.14);
}

.notes-list {
    padding: 12px 12px 0 12px;
    overflow-y: auto;
    flex-grow: 1;
    /* Thin scrollbar for modern browsers */
    scrollbar-width: thin;
    scrollbar-color: rgba(56, 75, 255, 0.7) rgba(255, 255, 255, 0.02);
}

/* WebKit-based browsers — styled track & thumb for glassy look */
.notes-list::-webkit-scrollbar {
    width: 10px;
}

.notes-list::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
}

.notes-list::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, rgba(56, 75, 255, 0.85), rgba(160, 32, 240, 0.85));
    border-radius: 10px;
    border: 2px solid rgba(0, 0, 0, 0);
    box-shadow: 0 2px 10px rgba(56, 75, 255, 0.12);
}

.notes-list::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, rgba(56, 75, 255, 1), rgba(160, 32, 240, 1));
}

.btn-new-note {
    background: linear-gradient(to bottom, var(--accent-blue), var(--accent-purple));
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 14px;
    box-shadow: 0px 0px 20px 0px rgba(56, 75, 255, 0.3), 0px 0px 40px 0px rgba(56, 75, 255, 0.15);
    display: flex;
    align-items: center;
    gap: 6px;
    transition: transform 0.2s ease;
}

.btn-new-note:hover {
    transform: translateY(-1px);
    color: white;
}

.btn-new-note img {
    width: 14px;
    height: 14px;
}

.blockchain-status-widget {
    background: linear-gradient(to right, rgba(0, 217, 255, 0.1), rgba(56, 75, 255, 0.1));
    border: 1px solid rgba(0, 217, 255, 0.3);
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-cyan);
    font-size: 12px;
    margin-bottom: 12px;
    box-shadow: 0px 0px 40px 0px rgba(0, 217, 255, 0.15), 0px 0px 20px 0px rgba(0, 217, 255, 0.3);
}

.glowing-dot {
    width: 8px;
    height: 8px;
    background-color: #00D9FF;
    border-radius: 50%;
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0% {
        box-shadow: 0 0 0 0 rgba(0, 217, 255, 0.7);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(0, 217, 255, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(0, 217, 255, 0);
    }
}

.sidebar-search input {
    width: 100%;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 15px 12px 20px 80px;
    /* increase left padding so icon stays well inside */
    color: white;
    font-size: 14px;
    box-sizing: border-box;
    height: 20px;
}

.sidebar-search .search-icon {
    position: absolute;
    left: 24px;
    /* nudged further inward so it does not approach the container edge */
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    opacity: 0.95;
    z-index: 3;
    transition: opacity .12s ease, transform .12s ease;
    pointer-events: none;
    /* avoid interfering with input clicks */
}

.sort-button {
    color: var(--text-secondary);
    font-size: 12px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: 6px;
    padding: 4px 8px;
    transition: background 0.2s ease;
}

.sort-button:hover {
    background: rgba(255, 255, 255, 0.05);
}

.sort-button img {
    width: 14px;
    height: 14px;
    opacity: 0.7;
}

.note-count {
    font-size: 12px;
    color: var(--text-muted);
}


.note-item {
    background: var(--surface-primary);
    border: 1px solid var(--surface-secondary);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.note-item:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
}

.note-item.active {
    background: linear-gradient(to bottom, var(--accent-blue), var(--accent-purple));
    border-color: transparent;
}

.note-item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.note-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-grow: 1;
}

.note-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.note-icon img {
    width: 100%;
    height: 100%;
    opacity: 0.7;
}

.note-item-header h3 {
    font-size: 16px;
    color: var(--text-primary);
    margin: 0;
    font-weight: 400;
    flex-grow: 1;
}

.note-options {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s ease;
}

.note-options:hover {
    background: rgba(255, 255, 255, 0.1);
}

.note-options img {
    width: 16px;
    height: 16px;
    opacity: 0.7;
}

.note-badge {
    margin-bottom: 8px;
}

.badge {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 2px 8px;
    font-size: 12px;
    color: var(--text-secondary);
    display: inline-block;
}

.note-item p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 8px 0;
    line-height: 1.4;
}

.note-item-footer {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
    margin-top: 12px;
}

.on-chain-badge {
    color: var(--accent-cyan);
    font-size: 12px;
    font-weight: 500;
}

.note-editor-view .note-title-input,
.note-editor-view .note-content-textarea {
    background: rgba(50, 37, 90, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    padding: 12px;
    color: white;
    width: 100%;
    box-sizing: border-box;
}

.note-editor-view .note-title-input {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 16px;
}

.note-editor-view .note-content-textarea {
    flex-grow: 1;
    gap: 12px;
}

/* Title input: boxed exactly like the content textarea */
.note-editor-view .note-title-input {
    background: rgba(50, 37, 90, 0.3);
    border: 1px solid var(--header-border);
    border-radius: 12px;
    padding: 16px;
    color: var(--text-primary);
    font-size: 20px;
    font-weight: 600;
    width: 100%;
    box-sizing: border-box;
    outline: none;
    margin-bottom: 16px;
}

/* On-chain pill */
.note-editor-view .on-chain-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 217, 255, 0.08);
    border: 1px solid rgba(0, 217, 255, 0.18);
    color: var(--accent-cyan);
    border-radius: 12px;
    padding: 6px 10px;
    font-size: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
}

.note-editor-view .on-chain-pill:hover {
    background: rgba(0, 217, 255, 0.15);
    border-color: rgba(0, 217, 255, 0.3);
    transform: translateY(-1px);
}



/* Toolbar */
.note-editor-view .note-editor-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}

/* Tags input & controls */
.tags-input-wrapper {
    display: flex;
    gap: 8px;
    align-items: center;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
    padding: 6px 8px;
    border: 1px solid rgba(255, 255, 255, 0.04);
}

.tags-input-wrapper input {
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-secondary);
    min-width: 120px;
}

/* Add tag button */
.btn-add {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    padding: 6px 10px;
    border-radius: 8px;
    cursor: pointer;
}

/* Badge list */
.badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.badge.tag-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 6px 8px;
    color: var(--text-primary);
    cursor: pointer;
}

/* Editor body and textarea */
.note-editor-view .note-editor-body {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.note-editor-view .note-content-textarea {
    background: rgba(50, 37, 90, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 16px;
    color: var(--text-secondary);
    font-size: 16px;
    line-height: 1.6;
    min-height: 320px;
    width: 100%;
    resize: vertical;
}

/* Action buttons */
.btn-save {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
    color: white;
    border: none;
    padding: 8px 14px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 0 6px 24px rgba(56, 75, 255, 0.14);
}

.btn-delete {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 8px 12px;
    border-radius: 10px;
    color: var(--text-primary);
    cursor: pointer;
}

.editor-actions {
    margin-top: 16px;
    display: flex;
    gap: 12px;
}

/* Empty State Styling */
.empty-state-editor {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 16px;
}

.empty-state-icon-wrapper {
    width: 80px;
    height: 80px;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(56, 75, 255, 0.2), rgba(160, 32, 240, 0.2));
    box-shadow: 0px 0px 0px 4px rgba(56, 75, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    position: relative;
    overflow: visible;
}

/* Gradient fill layer (SVG mask) — shown only when browser supports CSS masks */
.icon-gradient-fill {
    display: none;
}

@supports (-webkit-mask-image: none) or (mask-image: none) {
    .empty-state-icon-wrapper {
        overflow: hidden;
    }

    .icon-gradient-fill {
        display: block;
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
        -webkit-mask: url('/static/notes/img/Icon-1.svg') no-repeat center/contain;
        mask: url('/static/notes/img/Icon-1.svg') no-repeat center/contain;
        pointer-events: none;
        z-index: 1;
        transition: opacity .18s ease, transform .18s ease;
    }

    /* hide the <img> when the masked gradient is active to avoid duplication */
    .empty-state-icon-wrapper img {
        opacity: 0;
    }
}

.empty-state-icon-wrapper img {
    width: 40px;
    height: 40px;
}

.empty-state-editor h3 {
    font-size: 16px;
    color: var(--text-primary);
    margin: 0;
    font-weight: 400;
}

.empty-state-editor p {
    font-size: 14px;
    color: var(--text-muted);
    margin: 0;
}

/* Centered logout modal + backdrop */
.modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(6, 6, 12, 0.6);
    /* dark faded layer */
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .22s ease;
    z-index: 120;
}

.modal-backdrop.visible {
    opacity: 1;
    pointer-events: auto;
}

/* Centered dialog */
.modal-centered {
    transform: translateY(8px) scale(.98);
    transition: transform .22s ease, opacity .22s ease;
    opacity: 0;
    will-change: transform, opacity;
}

.modal-backdrop.visible .modal-centered {
    transform: translateY(0) scale(1);
    opacity: 1;
}

/* Modal body */
.modal-body {
    background: var(--header-bg);
    border: 1px solid var(--header-border);
    border-radius: 12px;
    padding: 20px;
    width: 420px;
    max-width: calc(100% - 48px);
    color: var(--text-primary);
    box-shadow: 0 18px 40px rgba(2, 4, 44, 0.6);
    text-align: left;
}

.modal-body h2 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
}

.modal-body p {
    margin: 0 0 16px;
    color: var(--text-muted);
    line-height: 1.4;
}

.modal-actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 8px;
}

/* Buttons */
.btn-cancel {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
}

.btn-cancel:focus {
    outline: 3px solid rgba(56, 75, 255, 0.18);
    outline-offset: 2px;
}

.btn-logout-confirm {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-purple));
    color: white;
    border: none;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(56, 75, 255, 0.12);
}

.btn-logout-confirm:focus {
    outline: 3px solid rgba(56, 75, 255, 0.18);
    outline-offset: 2px;
}

/* Accessibility: respect reduced motion */
@media (prefers-reduced-motion: reduce) {

    .modal-backdrop,
    .modal-centered {
        transition: none !important;
    }
}

/* Small screens */
@media (max-width: 480px) {
    .modal-body {
        width: calc(100% - 32px);
        padding: 16px;
        border-radius: 10px;
    }
}

/* ============================================
   CARD GRID LAYOUT STYLES
   ============================================ */

/* Dashboard Container */
.notes-dashboard {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 8px;
}

/* Dashboard Toolbar */
.dashboard-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 0 8px;
    flex-wrap: wrap;
}

.toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 250px;
}

.toolbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Search Container */
.toolbar-search {
    flex: 1;
    max-width: 400px;
    position: relative;
}

.toolbar-search input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 16px 12px 44px;
    color: white;
    font-size: 14px;
    outline: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
}

.toolbar-search input:focus {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(56, 75, 255, 0.1);
}

.toolbar-search .search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    opacity: 0.6;
    pointer-events: none;
}

/* Blockchain Status in Toolbar */
.toolbar-status {
    display: flex;
    align-items: center;
}

/* Notes Grid */
.notes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    overflow-y: auto;
    padding: 4px;
    padding-bottom: 24px;
    /* Scrollbar styling */
    scrollbar-width: thin;
    scrollbar-color: rgba(56, 75, 255, 0.7) rgba(255, 255, 255, 0.02);
}

.notes-grid::-webkit-scrollbar {
    width: 8px;
}

.notes-grid::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.02);
    border-radius: 10px;
}

.notes-grid::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, rgba(56, 75, 255, 0.85), rgba(160, 32, 240, 0.85));
    border-radius: 10px;
    border: 2px solid rgba(0, 0, 0, 0);
}

.notes-grid::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, rgba(56, 75, 255, 1), rgba(160, 32, 240, 1));
}

/* Note Card */
.note-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    min-height: 180px;
}

/* Hover Effects */
.note-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(56, 75, 255, 0.4);
    transform: translateY(-4px);
    box-shadow:
        0 8px 24px rgba(0, 0, 0, 0.3),
        0 0 0 1px rgba(56, 75, 255, 0.2),
        0 0 40px rgba(56, 75, 255, 0.15);
}

.note-card:active {
    transform: translateY(-2px);
}

/* Card Header */
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.card-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
    flex: 1;
    word-wrap: break-word;
}

/* Status Badge */
.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 20px;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
}

.status-badge.on-chain {
    background: rgba(0, 217, 255, 0.12);
    border: 1px solid rgba(0, 217, 255, 0.25);
    color: var(--accent-cyan);
    animation: glow-pulse 2s ease-in-out infinite;
}

.status-badge.on-chain img {
    width: 12px;
    height: 12px;
}

@keyframes glow-pulse {

    0%,
    100% {
        box-shadow: 0 0 8px rgba(0, 217, 255, 0.3);
    }

    50% {
        box-shadow: 0 0 16px rgba(0, 217, 255, 0.5);
    }
}

/* Card Body */
.card-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}

.card-preview {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-wrap: break-word;
}

/* Card Footer */
.card-footer {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.tag-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 12px;
    color: var(--text-muted);
    transition: all 0.2s ease;
}

.tag-pill:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
}

.card-date {
    font-size: 12px;
    color: var(--text-muted);
}

/* Editor View Modifications */
.note-editor-pane.fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    border-radius: 16px;
    padding: 20px;
    min-height: 180px;
    animation: skeleton-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-pulse {

    0%,
    100% {
        opacity: 0.4;
    }

    50% {
        opacity: 0.6;
    }
}

.skeleton-line {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    height: 12px;
    margin-bottom: 8px;
}

/* ============================================
   RESPONSIVE DESIGN - MOBILE & ANDROID
   ============================================ */

/* Tablet (768px - 1024px) */
@media (max-width: 1024px) {
    .notes-grid {
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }

    .dashboard-toolbar {
        gap: 12px;
    }

    .toolbar-search {
        max-width: 100%;
    }
}

/* Mobile & Android (max-width: 768px) */
@media (max-width: 768px) {
    .notes-app-container {
        padding: 16px 12px;
        height: calc(100vh - 140px);
    }

    .notes-dashboard {
        gap: 16px;
        padding: 0;
    }

    .dashboard-toolbar {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        padding: 0;
    }

    .toolbar-left {
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        min-width: 100%;
    }

    .toolbar-right {
        width: 100%;
        justify-content: space-between;
    }

    .toolbar-search {
        max-width: 100%;
        width: 100%;
    }

    .toolbar-search input {
        width: 100%;
    }

    /* 2-column grid on tablet portrait */
    .notes-grid {
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 12px;
        padding: 2px;
    }

    .note-card {
        padding: 16px;
        min-height: 160px;
    }

    .card-title {
        font-size: 16px;
    }

    .card-preview {
        font-size: 13px;
        -webkit-line-clamp: 2;
    }

    /* Fullscreen editor adjustments */
    .note-editor-pane.fullscreen {
        padding: 16px;
    }

    .note-editor-view .note-editor-container {
        padding: 16px;
    }
}

/* Small Mobile & Android (max-width: 480px) */
@media (max-width: 480px) {
    .new-header {
        margin: 16px 12px 8px;
        padding: 0 16px;
        height: 56px;
    }

    .notes-app-container {
        padding: 12px 8px;
        height: calc(100vh - 120px);
    }

    .notes-dashboard {
        gap: 12px;
    }

    .dashboard-toolbar {
        gap: 10px;
    }

    /* Single column grid on mobile */
    .notes-grid {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .note-card {
        padding: 14px;
        min-height: 140px;
    }

    .note-card:hover {
        /* Reduce hover effect on touch devices */
        transform: translateY(-2px);
    }

    .card-header {
        gap: 8px;
    }

    .card-title {
        font-size: 15px;
    }

    .card-preview {
        font-size: 12px;
    }

    .status-badge {
        font-size: 10px;
        padding: 3px 6px;
    }

    .tag-pill {
        font-size: 11px;
        padding: 3px 8px;
    }

    .card-date {
        font-size: 11px;
    }

    /* Toolbar adjustments */
    .btn-new-note {
        width: 100%;
        justify-content: center;
        padding: 10px 16px;
    }

    .sort-dropdown-toggle {
        font-size: 12px;
        padding: 6px 10px;
    }

    .blockchain-status-widget {
        font-size: 11px;
        padding: 6px 10px;
    }

    /* Editor fullscreen on mobile */
    .note-editor-pane.fullscreen {
        padding: 12px;
    }

    .note-title-input {
        font-size: 18px !important;
        padding: 12px !important;
    }

    .note-content-textarea {
        font-size: 14px !important;
        padding: 12px !important;
    }
}

/* Android-specific optimizations */
@media (max-width: 480px) and (orientation: portrait) {

    /* Optimize for Android portrait mode */
    .notes-grid {
        /* Account for Android nav bar */
        padding-bottom: 80px;
    }

    /* Larger touch targets for Android */
    .note-card {
        min-height: 150px;
    }

    .btn-new-note,
    .btn-save,
    .btn-delete,
    .btn-back {
        min-height: 44px;
        /* Android recommended touch target */
        padding: 10px 16px;
    }
}

/* Landscape mode for mobile/Android */
@media (max-width: 768px) and (orientation: landscape) {
    .notes-grid {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px;
    }

    .note-card {
        padding: 12px;
        min-height: 120px;
    }

    .card-preview {
        -webkit-line-clamp: 2;
    }
}

/* Accessibility: Respect reduced motion */
@media (prefers-reduced-motion: reduce) {

    .note-card,
    .btn-back,
    .tag-pill,
    .note-editor-pane.fullscreen {
        transition: none !important;
        animation: none !important;
    }

    .note-card:hover {
        transform: none;
    }
}

/* Back Button */
.btn-back {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
    padding: 8px 16px;
    border-radius: 10px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    transition: all 0.2s ease;
}

.btn-back:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateX(-2px);
}

/* Editor Top Bar */
.editor-top-bar {
    display: flex;
}

/* Editor Actions - No Extra Space */
.note-editor-view .editor-actions {
    .card-preview {
        font-size: 13px;
        -webkit-line-clamp: 2;
    }

    /* Fullscreen editor adjustments */
    .note-editor-pane.fullscreen {
        padding: 16px;
    }

    .note-editor-view .note-editor-container {
        padding: 16px;
    }
}

