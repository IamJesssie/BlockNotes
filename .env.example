# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://*.onrender.com

# Database Settings (Local uses MySQL, Production uses DATABASE_URL)
# DATABASE_URL will be automatically set by Render for production
# For local, leave this commented out to use MySQL

# Google OAuth Settings
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Add authorized redirect URIs:
#    - http://localhost:8000/accounts/google/login/callback/
#    - https://your-app-name.onrender.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Security Settings (for production, set these to True)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Logging
DJANGO_LOG_LEVEL=INFO
